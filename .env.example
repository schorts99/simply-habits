# Public origin for canonical URLs, social previews, and the sitemap. Rebuild after changing.
# Localhost previews are noindex; set the deployed HTTPS origin to enable indexing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public operator details rendered in Privacy/Terms. Required before launch; rebuild after changes.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=

# Real Web Push: generate VAPID keys with `npx web-push generate-vapid-keys`.
# Only the public key belongs in the browser bundle.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Long random secret for the scheduler's Authorization: Bearer header (minimum 32 chars).
CRON_SECRET=

# Optional. Without Firebase configuration, all personal tracking works locally.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only: use Application Default Credentials in production.
FIREBASE_PROJECT_ID=
# Optional alternative to ADC. Never prefix these with NEXT_PUBLIC_.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional local emulators (see README).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
